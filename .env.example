SECRET_KEY=change_me
SESSION_COOKIE_SECURE=0

# Local SQLite is used when DATABASE_URL is empty.
DATABASE_URL=

# PostgreSQL example:
# DATABASE_URL=postgresql://fabouanes:password@localhost:5432/fabouanes

DEFAULT_ADMIN_USERNAME=admin
# Leave empty to generate a first-launch PIN in AppData/FABOuanes/first_admin_password.txt.
DEFAULT_ADMIN_PASSWORD=

# SQLite performance tuning. Defaults are safe for a local desktop app.
# Increase cache on machines with more RAM; reduce it on very small machines.
FAB_SQLITE_BUSY_TIMEOUT_MS=15000
FAB_SQLITE_CACHE_KIB=131072
FAB_SQLITE_MMAP_BYTES=536870912
FAB_SQLITE_WAL_AUTOCHECKPOINT=2000
FAB_SQLITE_CACHED_STATEMENTS=512
