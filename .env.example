SECRET_KEY=change_me
SESSION_COOKIE_SECURE=0

# Local SQLite is used when DATABASE_URL is empty.
DATABASE_URL=

# PostgreSQL example:
# DATABASE_URL=postgresql://fabouanes:password@localhost:5432/fabouanes

DEFAULT_ADMIN_USERNAME=admin
# Leave empty to generate a first-launch PIN in AppData/FABOuanes/first_admin_password.txt.
DEFAULT_ADMIN_PASSWORD=
